# Example: postgresql://username:password@localhost:5432/midi_invaders
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/midi_invaders
# Optional API port (defaults to 3101).
PORT=3101

# Optional SMTP config for /admin OTP login.
# When unset, admin OTP requests will fail until these are configured.
ADMIN_SMTP_HOST=
ADMIN_SMTP_PORT=587
ADMIN_SMTP_SECURE=false
ADMIN_SMTP_USER=
ADMIN_SMTP_PASS=
ADMIN_SMTP_FROM=
