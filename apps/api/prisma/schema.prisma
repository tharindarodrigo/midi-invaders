generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model GameSession {
  id                  String               @id @default(cuid())
  seed                Int
  mode                String
  difficulty          String
  createdAt           DateTime             @default(now())
  expiresAt           DateTime
  scores              ScoreSubmission[]
  feedbackToken       FeedbackToken?
  feedbackSubmissions FeedbackSubmission[]
}

model ScoreSubmission {
  id          String   @id @default(cuid())
  sessionId   String
  displayName String
  score       Int
  accuracy    Float
  durationMs  Int
  mode        String
  difficulty  String
  createdAt   DateTime @default(now())

  session GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([mode, difficulty, score(sort: Desc)])
  @@index([createdAt])
}

model FeedbackToken {
  id                String    @id @default(cuid())
  sessionId         String    @unique
  tokenHash         String
  issuedAt          DateTime  @default(now())
  expiresAt         DateTime
  usedAt            DateTime?
  issuedIpHash      String?
  issuedUserAgentHash String?

  session GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model FeedbackSubmission {
  id           String   @id @default(cuid())
  sessionId    String   @unique
  rating       Int
  feedback     String
  mode         String
  difficulty   Int
  wave         Int
  score        Int
  durationMs   Int
  inputMode    String
  ipHash       String?
  userAgentHash String?
  riskFlags    String[]
  createdAt    DateTime @default(now())

  session GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([mode, difficulty, rating])
}

model AdminUser {
  id            String              @id @default(cuid())
  name          String
  email         String              @unique
  createdAt     DateTime            @default(now())
  otpChallenges AdminOtpChallenge[]
  sessions      AdminSession[]
}

model AdminOtpChallenge {
  id                   String    @id @default(cuid())
  adminUserId          String
  otpHash              String
  createdAt            DateTime  @default(now())
  expiresAt            DateTime
  consumedAt           DateTime?
  requestIpHash        String?
  requestUserAgentHash String?

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, createdAt])
  @@index([expiresAt])
}

model AdminSession {
  id                   String    @id @default(cuid())
  adminUserId          String
  tokenHash            String    @unique
  createdAt            DateTime  @default(now())
  expiresAt            DateTime
  revokedAt            DateTime?
  issuedIpHash         String?
  issuedUserAgentHash  String?

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}
